{
  "name": "dayflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "24.20.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run --maxWorkers=1",
    "test:rules": "node scripts/run-emulator-tests.mjs rules",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:integration": "node scripts/run-emulator-tests.mjs integration",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:preview": "PLAYWRIGHT_USE_PREVIEW=true node scripts/run-playwright.mjs",
    "test:e2e:sw": "node scripts/run-playwright.mjs --sw-dev",
    "test:e2e:run": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore",
    "check:pwa": "node scripts/check-pwa-installability.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "date-fns": "^4.1.0",
    "exceljs-hardened": "^5.1.0",
    "firebase": "^12.5.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.34.2",
    "globals": "^16.5.0",
    "jsdom": "^27.1.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@grpc/grpc-js": "^1.14.7"
  }
}
