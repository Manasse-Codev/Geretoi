# Variables obligatoires pour Firebase Auth et Firestore
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Variables optionnelles, non utilisées par les fonctionnalités actuelles
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Options de développement
VITE_USE_EMULATORS=true
VITE_ENABLE_SW_DEV=false

# Définir VITE_FIREBASE_AUTH_DOMAIN par plateforme si les domaines diffèrent.
# Utilisé par Firebase Auth pour les redirections et le handler /__/auth/handler.

# Ports définis dans firebase.json : Auth 9099, Firestore 18080, WebSocket Firestore 19150.
